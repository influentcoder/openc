{
  "name": "openc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:fake": "node scripts/dev.ts --fake",
    "start": "node src/server/main.ts",
    "start:fake": "node src/server/main.ts --fake",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "rules": "node scripts/check-code-rules.ts",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --project server --project web",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm rules && pnpm boundaries && pnpm test",
    "e2e": "pnpm build && playwright test --trace off",
    "db:generate": "drizzle-kit generate",
    "prepare": "lefthook install",
    "test:contract:live": "vitest run --project live --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@hono/node-server": "^2.1.11",
    "@tanstack/react-query": "^5.108.2",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "dependency-cruiser": "^18.8.0",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
